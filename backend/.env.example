# Copy to backend/.env and fill in. Never commit .env. Values below are examples only.
GEMINI_API_KEY=                # AI Studio key (only used when Vertex is off; HTTP 402 = prepaid credit spent)
# Vertex AI (billed to the Google Cloud account). With VERTEX_API_KEY set that is all it needs:
GOOGLE_GENAI_USE_VERTEXAI=true
VERTEX_API_KEY=
# Optional instead of an API key: Application Default Credentials (gcloud auth application-default login)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global   # the Gemini 3.x models are served from `global`
GEMINI_MODEL_VISION=gemini-3.6-flash
GEMINI_MODEL_VISION_FALLBACK=gemini-3.5-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
COSTAR_API_KEY=
VEXCEL_API_KEY=
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=

CACHE_MODE=read_write          # off | read_write | read_only (use read_only for the demo)
ENGINE_MODE=live               # live = real quant engine (app.engine, needs numpy + pulp[cbc]); stub = placeholder pricing
NESSIE_MODE=stub               # stub | live (live needs NESSIE_API_KEY, NESSIE_CUSTOMER_ID, NESSIE_SOURCE_ACCOUNT_ID)
DEMO_CITY=Houston
MAX_CONCURRENT_BUILDINGS=4
# MAX_TOKENS_PER_SURVEY=0      # 0 = unlimited

# Frontend origins allowed by CORS (comma separated, no trailing slash). Optional regex for preview URLs.
CORS_ORIGINS=http://localhost:5173
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Live Nessie only
# NESSIE_CUSTOMER_ID=
# NESSIE_SOURCE_ACCOUNT_ID=

# Nessie sandbox (live mode). Ids come from the Nessie teammate's code; the key is hers (nessie/.env).
# NESSIE_API_KEY=
# NESSIE_CUSTOMER_ID=4dba3d91-00ae-405b-bdf1-aac090f66996
# NESSIE_SOURCE_ACCOUNT_ID=3e4f8885-befb-4d0f-85ad-545b776f0888
