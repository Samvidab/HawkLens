# HawkLens backend environment — copy to backend/.env and fill in real values.
# NEVER commit backend/.env (it is gitignored). Secrets come from env only.

# --- Matterport platform (required for the Matterport 3D property platform) ---
# HTTP basic auth: token ID is the username, token secret is the password.
MP_TOKEN_ID=
MP_TOKEN_SECRET=
# Defaults below are usually fine; override only if needed.
MP_API_URL=https://api.matterport.com/api/models/graph
MP_MAX_RETRIES=5
MP_BACKOFF_BASE_S=0.5
# Comma list of asset types to download. Point clouds are large; add "pointcloud" to include.
MP_ASSET_TYPES=mesh,images
MP_ENABLE_WEBHOOKS=false
MP_ENABLE_GLTF_VIEWER=false

# --- Cache / run modes (shared with the rest of the backend) ---
# off = always hit network; read_write = cache + fill; read_only = cache only (offline demo/CI)
CACHE_MODE=read_write

# --- Other toolkit keys (unrelated to Matterport; leave blank if unused) ---
GEMINI_API_KEY=
COSTAR_API_KEY=
VEXCEL_API_KEY=
