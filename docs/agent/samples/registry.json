{
  "grid_columns": {
    "full": 12,
    "wide": 8,
    "half": 6,
    "side": 4
  },
  "max_widgets": 8,
  "widgets": {
    "target_control": {
      "description": "Goal sliders and p(hit)",
      "default_size": "full",
      "emits": [
        "set_target",
        "set_budget",
        "set_risk"
      ],
      "required": [
        "target_pct",
        "risk_lambda"
      ],
      "props_schema": {
        "additionalProperties": false,
        "properties": {
          "target_pct": {
            "title": "Target Pct",
            "type": "number"
          },
          "budget_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Budget Usd"
          },
          "risk_lambda": {
            "title": "Risk Lambda",
            "type": "number"
          },
          "p_hit_target": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "P Hit Target"
          },
          "tonnes_needed": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Tonnes Needed"
          },
          "tonnes_planned": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Tonnes Planned"
          },
          "risk_supported": {
            "default": true,
            "title": "Risk Supported",
            "type": "boolean"
          }
        },
        "required": [
          "target_pct",
          "risk_lambda"
        ],
        "title": "TargetControl",
        "type": "object"
      }
    },
    "portfolio_3d": {
      "description": "Buildings in 3D",
      "default_size": "wide",
      "emits": [
        "open_building",
        "exclude_building",
        "include_building"
      ],
      "required": [
        "buildings"
      ],
      "props_schema": {
        "$defs": {
          "Building3D": {
            "additionalProperties": false,
            "properties": {
              "building_id": {
                "title": "Building Id",
                "type": "string"
              },
              "name": {
                "title": "Name",
                "type": "string"
              },
              "lat": {
                "title": "Lat",
                "type": "number"
              },
              "lon": {
                "title": "Lon",
                "type": "number"
              },
              "footprint_wkt": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Footprint Wkt"
              },
              "height_m": {
                "title": "Height M",
                "type": "number"
              },
              "roof_texture_url": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Roof Texture Url"
              },
              "color_metric": {
                "title": "Color Metric",
                "type": "string"
              },
              "color_value": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Color Value"
              },
              "excluded": {
                "default": false,
                "title": "Excluded",
                "type": "boolean"
              },
              "overlays": {
                "default": [],
                "items": {
                  "$ref": "#/$defs/Overlay"
                },
                "title": "Overlays",
                "type": "array"
              }
            },
            "required": [
              "building_id",
              "name",
              "lat",
              "lon",
              "height_m",
              "color_metric"
            ],
            "title": "Building3D",
            "type": "object"
          },
          "Overlay": {
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "solar",
                  "cool_roof",
                  "window"
                ],
                "title": "Type",
                "type": "string"
              },
              "polygon_wkt": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Polygon Wkt"
              },
              "facade": {
                "anyOf": [
                  {
                    "enum": [
                      "N",
                      "E",
                      "S",
                      "W"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Facade"
              }
            },
            "required": [
              "type"
            ],
            "title": "Overlay",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "buildings": {
            "items": {
              "$ref": "#/$defs/Building3D"
            },
            "title": "Buildings",
            "type": "array"
          },
          "focus_building_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Focus Building Id"
          }
        },
        "required": [
          "buildings"
        ],
        "title": "Portfolio3D",
        "type": "object"
      }
    },
    "hero_3d": {
      "description": "Matterport mesh with finding pins",
      "default_size": "wide",
      "emits": [],
      "required": [
        "building_id"
      ],
      "props_schema": {
        "$defs": {
          "Pin": {
            "properties": {
              "claim_id": {
                "title": "Claim Id",
                "type": "string"
              },
              "label": {
                "title": "Label",
                "type": "string"
              },
              "xyz": {
                "maxItems": 3,
                "minItems": 3,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "title": "Xyz",
                "type": "array"
              },
              "status": {
                "title": "Status",
                "type": "string"
              }
            },
            "required": [
              "claim_id",
              "label",
              "xyz",
              "status"
            ],
            "title": "Pin",
            "type": "object"
          },
          "Room": {
            "additionalProperties": false,
            "properties": {
              "room_id": {
                "title": "Room Id",
                "type": "string"
              },
              "type": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Type"
              },
              "polygon": {
                "default": [],
                "items": {
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                "title": "Polygon",
                "type": "array"
              },
              "area_sqft": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Area Sqft"
              }
            },
            "required": [
              "room_id"
            ],
            "title": "Room",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "`mode` \"mesh\": render the OBJ/MTL (pins are in mesh coordinates). `mode` \"showcase\": embed the Matterport\n3D tour (`showcase_url`, an iframe link); mesh urls are then null and pins are informational only.",
        "properties": {
          "building_id": {
            "title": "Building Id",
            "type": "string"
          },
          "mode": {
            "default": "mesh",
            "enum": [
              "mesh",
              "showcase"
            ],
            "title": "Mode",
            "type": "string"
          },
          "mesh_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Mesh Url"
          },
          "mtl_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Mtl Url"
          },
          "showcase_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Showcase Url"
          },
          "pins": {
            "default": [],
            "items": {
              "$ref": "#/$defs/Pin"
            },
            "title": "Pins",
            "type": "array"
          },
          "rooms": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/$defs/Room"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Rooms"
          }
        },
        "required": [
          "building_id"
        ],
        "title": "Hero3D",
        "type": "object"
      }
    },
